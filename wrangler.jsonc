{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hocnoihocviet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by OpenNext's cache; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hocnoihocviet"
    }
  ],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hocnoihocviet-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set in the dashboard, type Secret): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
  // Optional: ALLOWED_EMAILS (comma-separated) to limit sign-up during beta.
}
