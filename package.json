    "@fontsource/newsreader": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@remixicon/react": "^4.9.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
